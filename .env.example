# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube a Git.
#   cp .env.example .env

# --- PostgreSQL 17 ---
POSTGRES_DB=villaserena
POSTGRES_USER=villaserena
POSTGRES_PASSWORD=<TU_CONTRASENA_POSTGRES>

# --- MinIO (la contraseña debe tener al menos 8 caracteres) ---
MINIO_ROOT_USER=villaserena
MINIO_ROOT_PASSWORD=<TU_CONTRASENA_MINIO>
# Público: fotos del hotel, habitaciones y menú. Privado: PDF de facturas y fotos de incidencias.
MINIO_BUCKET_PUBLIC=villaserena-publico
MINIO_BUCKET_PRIVATE=villaserena-privado

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<TU_CONTRASENA_GRAFANA>

# --- Stack de aplicación (docker-compose.app.yml: API + web) ---
# Perfil del API: "demo" carga los datos ficticios (necesita los 3 hashes de abajo).
SPRING_PROFILES_ACTIVE=demo
# Clave de firma de los JWT, en Base64 (al menos 32 bytes):
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<CLAVE_BASE64_DE_AL_MENOS_32_BYTES>
# Los mismos hashes que el .env del API (ver su .env.example). Van entre comillas
# simples porque el hash BCrypt contiene "$" y Compose lo interpretaría como variable.
DEMO_PASSWORD_HASH='<HASH_BCRYPT_DE_TU_CONTRASENA>'
CANAL1_KEY_HASH=<SHA256_DE_LA_CLAVE_DE_BOOKING>
CANAL2_KEY_HASH=<SHA256_DE_LA_CLAVE_DE_EXPEDIA>
# Modos de la web (opcionales; por defecto "demo").
STAFF_AUTH_MODE=demo
VILLA_SERENA_BFF_MODE=demo
