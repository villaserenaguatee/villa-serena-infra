*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform plan files
*.tfplan
*.tfplan.*

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# OS and Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
# env
.env
